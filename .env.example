# Public browser configuration.
# The Turnstile site key is intentionally public.
VITE_TURNSTILE_SITE_KEY=
VITE_SITE_URL=

# Cloudflare Worker runtime — narrow same-origin gateway only.
# No Supabase service-role key, Turnstile secret, request fingerprint key,
# Telegram bot token or customer data secret belongs in the Worker.
SUPABASE_FUNCTION_BASE_URL=https://your-project-ref.supabase.co/functions/v1
EDGE_GATEWAY_KEYS_JSON={"gateway-v1":"replace-with-at-least-32-random-characters"}
EDGE_GATEWAY_PRIMARY_KEY_ID=gateway-v1
IP_HASH_SECRET=
SITE_URL=https://example.invalid
ALLOWED_ORIGINS=https://example.invalid
PUBLIC_INDEXING=false

# Build-only structured content/private media access. These values exist only in
# the CI runner while generating sanitized public artifacts; never expose them
# to browser code or Cloudflare Worker runtime secrets.
BUILD_SUPABASE_URL=https://your-project-ref.supabase.co/
BUILD_SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function runtime — authoritative request/business validation.
# Configure these in Supabase secret storage, never in browser or Worker secrets.
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_EXPECTED_ACTION=submit_request
TRACKING_CODE_PREFIX=REQ
SITEVERIFY_NAMESPACE_UUID=
EDGE_GATEWAY_KEYS_JSON={"gateway-v1":"replace-with-the-same-gateway-secret-map"}
REQUEST_FINGERPRINT_KEYS_JSON={"request-v1":"replace-with-at-least-32-random-characters"}
REQUEST_FINGERPRINT_PRIMARY_KEY_ID=request-v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# GitHub repository secrets used by the target-isolated Cloudflare workflow.
PREVIEW_CLOUDFLARE_ACCOUNT_ID=
PREVIEW_CLOUDFLARE_API_TOKEN=
PREVIEW_VITE_TURNSTILE_SITE_KEY=
PREVIEW_SUPABASE_FUNCTION_BASE_URL=
PREVIEW_EDGE_GATEWAY_KEYS_JSON=
PREVIEW_EDGE_GATEWAY_PRIMARY_KEY_ID=
PREVIEW_IP_HASH_SECRET=
PREVIEW_BUILD_SUPABASE_URL=
PREVIEW_BUILD_SUPABASE_SERVICE_ROLE_KEY=
PRODUCTION_CLOUDFLARE_ACCOUNT_ID=
PRODUCTION_CLOUDFLARE_API_TOKEN=
PRODUCTION_VITE_TURNSTILE_SITE_KEY=
PRODUCTION_SUPABASE_FUNCTION_BASE_URL=
PRODUCTION_EDGE_GATEWAY_KEYS_JSON=
PRODUCTION_EDGE_GATEWAY_PRIMARY_KEY_ID=
PRODUCTION_IP_HASH_SECRET=
PRODUCTION_BUILD_SUPABASE_URL=
PRODUCTION_BUILD_SUPABASE_SERVICE_ROLE_KEY=

# GitHub repository secrets used by backup automation.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SESSION_POOLER_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=
BACKUP_ENCRYPTION_RECIPIENT=
HEALTHCHECKS_BACKUP_PING_URL=

# GitHub repository variables (not secrets). The workflow selects one pair by
# deploy_target and derives SITE_URL, ALLOWED_ORIGINS and PUBLIC_INDEXING.
PREVIEW_SITE_URL=
PRODUCTION_SITE_URL=
PREVIEW_ALLOWED_ORIGINS=
PRODUCTION_ALLOWED_ORIGINS=

# SMS is intentionally deferred. Do not add an SMS provider key until a provider
# is selected and a server-only adapter is reviewed.
