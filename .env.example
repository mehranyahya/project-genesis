# Server-only Supabase content/request integration.
# Never expose SUPABASE_SERVICE_ROLE_KEY to browser code or commit a real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Request idempotency fingerprinting. Use independent random secrets of at least
# 32 characters. Keep REQUEST_FINGERPRINT_KEY_ID stable while requests created
# with the current key may still be replayed inside the 24-hour window.
REQUEST_FINGERPRINT_KEY=
REQUEST_FINGERPRINT_KEY_ID=v1

# Server-only HMAC key for hashing Cloudflare's connecting IP before persistence.
# The raw IP is never sent to Supabase or stored by the request API.
IP_HASH_KEY=

# Turnstile token verification is intentionally wired in a later security stage.
# Until then, requests are persisted as unverified_no_token and need_review=true.
